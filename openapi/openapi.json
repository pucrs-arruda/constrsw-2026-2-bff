            "type": "integer",
            "minimum": 0,
            "description": "BFF read-model count of occurrences whose status is OPEN.",
            "example": 1
          },
          "reservations": {
            "$ref": "#/components/schemas/FutureReservations"
          }
        }
      },
      "Resource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "name",
          "type",
          "active",
          "tags",
          "createdAt",
          "updatedAt",
          "openOccurrenceCount",
          "occurrences",
          "reservations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$",
            "example": "PROJ-01"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Projector 1"
          },
          "type": {
            "$ref": "#/components/schemas/ResourceType"
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "example": [
              "av",
              "portable"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "openOccurrenceCount": {
            "type": "integer",
            "minimum": 0,
            "description": "BFF read-model count of occurrences whose status is OPEN.",
            "example": 1
          },
          "occurrences": {
            "$ref": "#/components/schemas/OccurrenceList"
          },
          "reservations": {
            "$ref": "#/components/schemas/FutureReservations"
          }
        }
      },
      "ResourceList": {
        "type": "array",
        "description": "Ordered by code ascending. Bare array (no envelope), matching docs/open-api/bff.yaml.",
        "items": {
          "$ref": "#/components/schemas/ResourceSummary"
        }
      },
      "Occurrence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "resourceId",
          "description",
          "type",
          "priority",
          "status",
          "resolution",
          "reportedBy",
          "resolvedBy",
          "createdAt",
          "resolvedAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "resourceId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "$ref": "#/components/schemas/OccurrenceType"
          },
          "priority": {
            "$ref": "#/components/schemas/OccurrencePriority"
          },
          "status": {
            "$ref": "#/components/schemas/OccurrenceStatus"
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "reportedBy": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "resolvedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "readOnly": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "resolvedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "OccurrenceList": {
        "type": "array",
        "description": "Ordered by createdAt descending, then id descending. Bare array (no envelope).",
        "items": {
          "$ref": "#/components/schemas/Occurrence"
        }
      },
      "ResourceCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "type"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "$ref": "#/components/schemas/ResourceType"
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "default": [],
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
            }
          }
        }
      },
      "ResourceUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "$ref": "#/components/schemas/ResourceType"
          },
          "active": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30,
              "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
            }
          }
        }
      },
      "OccurrenceCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "type"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "$ref": "#/components/schemas/OccurrenceType"
          },
          "priority": {
            "$ref": "#/components/schemas/OccurrencePriority",
            "default": "MEDIUM"
          }
        }
      },
      "OccurrenceResolve": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolution"
        ],
        "properties": {
          "resolution": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "FutureReservations": {
        "type": "array",
        "description": "Reservations futuras do resource, compostas pela BFF a partir do contexto reservations. Somente leitura; vazio quando não há reserva futura.",
        "items": {
          "$ref": "#/components/schemas/Reservation"
        }
      },
      "Reservation": {
        "title": "Reservation",
        "description": "Reserva como devolvida pelo contexto reservations (somente leitura nesta BFF).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "professorId",
          "lessonId",
          "data",
          "faixaId",
          "resourceIds",
          "status",
          "enabled",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "professorId": {
            "type": "string",
            "format": "uuid"
          },
          "lessonId": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "type": "string",
            "format": "date"
          },
          "faixaId": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              "H",
              "I",
              "J",
              "K",
              "L",
              "M",
              "N",
              "P"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "resourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CANCELLED"
            ]
          },
          "enabled": {
            "type": "boolean",
            "readOnly": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "parameters": {
