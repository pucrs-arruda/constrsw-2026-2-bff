                "value": {
                  "type": "urn:closed-cras:not-found",
                  "title": "Resource not found",
                  "status": 404,
                  "detail": "No resource exists with the supplied id.",
                  "instance": "/api/v1/resources/6f1c2d3e-4a5b-4c6d-8e7f-901234567890",
