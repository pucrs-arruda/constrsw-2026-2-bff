      },
      "bffSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cras_session",
        "description": "BFF session cookie set by the shared auth module. httpOnly, SameSite=Lax.\nThe BFF validates the session and forwards the user's Bearer token to the\nresources context. This module does not set or refresh the cookie.\n"
      }
