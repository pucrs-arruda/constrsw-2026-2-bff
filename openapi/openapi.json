              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "malformed": {
                "value": {
                  "type": "urn:closed-cras:malformed-request",
                  "title": "Malformed request",
                  "status": 400,
                  "detail": "The request body is not valid JSON.",
                  "instance": "/api/v1/resources",
                  "code": "MALFORMED_REQUEST"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No session, expired session, or the BFF could not obtain a valid user\ntoken. The browser redirects to UX-LOGIN; API clients receive this body.\n",
