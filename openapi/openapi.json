          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "resources": {
                "value": {
                  "type": "urn:closed-cras:dependency:unavailable",
                  "title": "Resources context unavailable",
