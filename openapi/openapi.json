            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "mediaType": {
                "value": {
                  "type": "urn:closed-cras:unsupported-media-type",
                  "title": "Unsupported media type",
                  "status": 415,
                  "detail": "Content-Type must be application/json.",
                  "instance": "/api/v1/resources",
                  "code": "UNSUPPORTED_MEDIA_TYPE"
                }
              }
            }
          }
        }
