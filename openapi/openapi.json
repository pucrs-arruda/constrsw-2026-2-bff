            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "code": {
                "value": {
                  "type": "urn:closed-cras:validation",
                  "title": "Request validation failed",
                  "status": 422,
                  "detail": "The request body has invalid fields.",
                  "instance": "/api/v1/resources",
                  "code": "VALIDATION",
                  "errors": [
                    {
                      "field": "code",
