# Espelha as variáveis que o docker-compose.yml do repositório base já passa ao serviço `bff`.
# Serve para rodar fora do compose; dentro dele, quem manda é o .env do base.
PORT=3001
BFF_ORIGIN=http://localhost:4200
SESSION_COOKIE_NAME=closed_cras_session

# URLs are service origins, without /api/v1. Classes is required for principal GETs.
COURSES_BASE_URL=http://localhost:8085
# Optional separate Prometheus listener; /metrics also exists on PORT.
BFF_INTERNAL_METRICS_PORT=9091

# Contexto reservations (Grupo 03) e validação do JWT no Keycloak (o JWKS sai de JWT_ISSUER)
RESERVATIONS_BASE_URL=http://localhost:8187
JWT_ISSUER=http://keycloak:8080/realms/constrsw
JWT_AUDIENCE=oauth

# Contexto rooms (Grupo 08)
ROOMS_BASE_URL=http://localhost:8105

# Contexto students (Grupo 04) e classes, usado na composição T3 de students
STUDENTS_BASE_URL=http://localhost:8190
CLASSES_BASE_URL=http://localhost:8182

# Resiliência dos hops BFF->domínio (AD-10)
BFF_HTTP_TIMEOUT_MS=3000
BFF_HTTP_RETRIES=2
BFF_CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
BFF_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
BFF_CIRCUIT_BREAKER_VOLUME_THRESHOLD=10
BFF_CIRCUIT_BREAKER_ROLLING_WINDOW_MS=10000
